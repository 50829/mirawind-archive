		Content-Security-Policy "default-src 'none'; base-uri 'none'; font-src https://{$MIRAWIND_PUBLIC_HOST:localhost} data:; form-action 'none'; frame-ancestors https://{$MIRAWIND_PUBLIC_HOST:localhost}; img-src https://{$MIRAWIND_PUBLIC_HOST:localhost} data:; object-src 'none'; script-src https://{$MIRAWIND_PUBLIC_HOST:localhost}; style-src https://{$MIRAWIND_PUBLIC_HOST:localhost} 'unsafe-inline'; upgrade-insecure-requests"
		Cross-Origin-Resource-Policy "cross-origin"
		Referrer-Policy "no-referrer"
