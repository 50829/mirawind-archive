{
  "name": "mirawind-archive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "astro build && tsc -p tsconfig.processes.json && node scripts/copy-runtime-schemas.mjs",
    "commitlint": "commitlint",
    "db:migrate": "tsx src/cli/index.ts db migrate",
    "dev": "astro dev",
    "dev:web": "astro dev",
    "dev:worker": "tsx src/worker/index.ts",
    "format": "prettier --check package.json pnpm-workspace.yaml tsconfig.json tsconfig.processes.json astro.config.mjs eslint.config.js commitlint.config.mjs vitest.config.ts playwright.config.ts CONTRIBUTING.md .github/workflows src tests scripts docs/operations docs/third-party",
    "format:write": "prettier --write package.json pnpm-workspace.yaml tsconfig.json tsconfig.processes.json astro.config.mjs eslint.config.js commitlint.config.mjs vitest.config.ts playwright.config.ts CONTRIBUTING.md .github/workflows src tests scripts docs/operations docs/third-party",
    "lint": "eslint .",
    "mirawind": "tsx src/cli/index.ts",
    "preview": "astro preview",
    "start": "node dist/server/entry.mjs",
    "test": "vitest run --passWithNoTests",
    "test:contract": "vitest run --project contract --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "typecheck": "astro check && tsc --noEmit && tsc -p tsconfig.processes.json --noEmit",
    "worker": "node dist/processes/worker/index.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/node": "11.0.2",
    "@astrojs/react": "6.0.1",
    "@better-auth/passkey": "1.6.25",
    "@inquirer/prompts": "8.5.2",
    "@zip.js/zip.js": "2.8.34",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.1.3",
    "better-auth": "1.6.25",
    "better-sqlite3": "12.11.1",
    "katex": "0.18.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.3",
    "shiki": "4.3.1",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/katex": "0.16.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "happy-dom": "20.11.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
