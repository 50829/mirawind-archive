---
import { AdminLibraryEnhancement } from "@/web/components/library/AdminLibraryEnhancement";
import { LibraryScene } from "@/web/components/library/LibraryScene";
import { createCatalogServer } from "@/composition/server";
import { resolveRuntimeAdministrator } from "@/http/authorization/runtime-admin";
import { libraryHtmlResponse } from "@/http/cache/library-response";
import "@/styles/global.css";

export const prerender = false;

const { database } = resolveRuntimeAdministrator(Astro.locals.session);
const library = createCatalogServer(database).publicLibrary();
const response = libraryHtmlResponse({
  digest: library.digest,
  rendererIdentity: "library-scene-v1",
  request: Astro.request,
  requestPath: Astro.url.pathname,
  access: "public",
});
if (response.notModified) return response.notModified;
for (const [name, value] of response.headers) {
  Astro.response.headers.set(name, value);
}
const canonical = new URL("/library", Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Mirawind Library：浏览并阅读已经发布的语义图书。"
    />
    <link rel="canonical" href={canonical} />
    <title>书库 · Mirawind</title>
  </head>
  <body>
    <nav class="site-nav" aria-label="站点导航">
      <a class="brand" href="/">MIRAWIND</a>
      <a aria-current="page" href="/library">书库</a>
    </nav>
    <main>
      <LibraryScene library={library} />
      <AdminLibraryEnhancement client:load />
    </main>
  </body>
</html>

<script>
  import { installDetailsNavigation } from "@/web/components/library/details-navigation";

  installDetailsNavigation();
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    color-scheme: light;
  }
  :global(body) {
    min-width: 20rem;
    min-height: 100vh;
    margin: 0;
    color: var(--color-stone-800);
    background: var(--color-stone-100);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  :global(a) {
    color: inherit;
    text-underline-offset: 0.2em;
  }
  :global(a:focus-visible),
  :global(button:focus-visible) {
    outline: 3px solid var(--color-amber-700);
    outline-offset: 3px;
  }
  .site-nav {
    position: sticky;
    z-index: 10;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem max(1rem, calc((100vw - 78rem) / 2));
    border-bottom: 1px solid var(--color-stone-300);
    background: color-mix(in oklab, var(--color-stone-100) 94%, transparent);
    backdrop-filter: blur(12px);
  }
  .brand,
  :global(.eyebrow) {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  main {
    width: min(78rem, calc(100vw - 2rem));
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 6rem) 0 5rem;
  }
  :global(.library-heading),
  :global(.admin-library > header) {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }
  :global(.library-heading h1) {
    margin: 0.15rem 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 500;
    line-height: 0.9;
  }
  :global(.library-heading > p) {
    max-width: 28rem;
    color: var(--color-stone-600);
    line-height: 1.7;
  }
  :global(.library-notice),
  :global(.library-empty) {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--color-stone-300);
    border-radius: 0.75rem;
    background: var(--color-stone-50);
  }
  :global(.library-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }
  :global(.library-card) {
    overflow: hidden;
    border: 1px solid var(--color-stone-300);
    border-radius: 1rem;
    background: var(--color-white);
    box-shadow: 0 0.8rem 2rem
      color-mix(in oklab, var(--color-stone-900) 7%, transparent);
  }
  :global(.library-cover) {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    color: var(--color-amber-100);
    background: var(--color-emerald-950);
    text-decoration: none;
  }
  :global(.library-cover img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.library-cover-placeholder) {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 5rem;
  }
  :global(.library-card-copy) {
    padding: 1.25rem;
  }
  :global(.library-card h2) {
    min-height: 2.6em;
    margin: 0;
    overflow-wrap: anywhere;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
    line-height: 1.3;
  }
  :global(.library-authors) {
    min-height: 1.5em;
    color: var(--color-stone-600);
  }
  :global(.library-card-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.25rem;
  }
  :global(.primary-action) {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    padding: 0.6rem 0.9rem;
    border-radius: 999px;
    color: var(--color-white);
    background: var(--color-emerald-800);
    text-decoration: none;
  }
  :global(.admin-library) {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-stone-400);
  }
  :global(.admin-library ul) {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  :global(.admin-library li) {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-stone-200);
  }
  :global(.admin-library li span) {
    color: var(--color-stone-600);
  }
  @media (max-width: 40rem) {
    :global(.library-heading),
    :global(.admin-library > header) {
      display: block;
    }
    :global(.library-heading > p) {
      margin-top: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
    }
  }
</style>
