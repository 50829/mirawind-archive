---
import { LoginPanel } from "@/components/auth/LoginPanel";
import { applyResponsePolicy } from "@/http/response-policy";

export const prerender = false;

if (Astro.locals.session) {
  const headers = new Headers({ Location: "/manage" });
  applyResponsePolicy(headers, "login");
  return new Response(null, {
    headers,
    status: 303,
  });
}

applyResponsePolicy(Astro.response.headers, "login");

const requestedNext = Astro.url.searchParams.get("next") ?? undefined;
const nextPath =
  requestedNext?.startsWith("/") && !requestedNext.startsWith("//")
    ? requestedNext
    : "/manage";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>管理员登录 · Mirawind</title>
  </head>
  <body>
    <main>
      <LoginPanel client:load nextPath={nextPath} />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    color: #f7efe2;
    background:
      radial-gradient(circle at 15% 10%, #493725 0, transparent 30rem), #171512;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  main {
    width: min(31rem, calc(100vw - 2rem));
    padding: 2rem;
    border: 1px solid #4c4237;
    border-radius: 1rem;
    background: #211e1acc;
    box-shadow: 0 1.5rem 5rem #0007;
  }

  :global(.login-panel h1) {
    margin: 0.25rem 0 0.75rem;
    font-family: Georgia, serif;
    font-size: 2.5rem;
  }

  :global(.eyebrow) {
    margin: 0;
    color: #e2aa66;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  :global(.lede),
  :global(.recovery),
  :global(.message) {
    color: #c7bcad;
  }

  :global(button),
  :global(input) {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid #695c4d;
    border-radius: 0.45rem;
    font: inherit;
  }

  :global(button) {
    margin-top: 0.75rem;
    color: #171512;
    background: #e2aa66;
    cursor: pointer;
  }

  :global(button:disabled) {
    cursor: wait;
    opacity: 0.6;
  }

  :global(details) {
    margin-top: 1.5rem;
  }

  :global(summary) {
    cursor: pointer;
  }

  :global(label) {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
    color: #d9d0c5;
  }

  :global(input) {
    padding: 0.6rem 0.75rem;
    color: #f7efe2;
    background: #151310;
  }

  :global(.recovery) {
    margin-top: 1.5rem;
    font-size: 0.82rem;
  }
</style>
