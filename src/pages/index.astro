---
import "@/styles/global.css";

const title = "Mirawind Library";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <a class="library-link" href="/library">查看书库</a>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-height: 100vh;
    margin: 0;
    display: grid;
    place-items: center;
    color: var(--color-stone-100);
    background: var(--color-stone-950);
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  main {
    width: min(42rem, calc(100vw - 3rem));
  }

  h1 {
    margin: 0.35rem 0 0.75rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 0.95;
  }

  .library-link {
    display: inline-flex;
    min-height: 2.8rem;
    align-items: center;
    margin-top: 1rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    color: var(--color-stone-950);
    background: var(--color-amber-500);
    font-weight: 700;
    text-decoration: none;
  }

  .library-link:focus-visible {
    outline: 3px solid var(--color-white);
    outline-offset: 3px;
  }
</style>
