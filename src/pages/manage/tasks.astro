---
import {
  TaskMonitor,
  type TaskView,
} from "@/web/components/import/TaskMonitor";
import ManageShell from "@/web/components/manage/ManageShell.astro";
import { createPublishingServer } from "@/composition/server";
import {
  hiddenManagementPage,
  redirectToAdministratorLogin,
} from "@/http/authorization/manage-page";
import { requireRuntimeAdministrator } from "@/http/authorization/runtime-admin";
import { applyResponsePolicy } from "@/http/cache/policies";
import "@/styles/global.css";

export const prerender = false;

// Astro's frontmatter checker does not count return expressions as symbol reads.
void hiddenManagementPage;
void redirectToAdministratorLogin;

if (!Astro.locals.session) {
  return redirectToAdministratorLogin(Astro.url.pathname);
}

let database;
try {
  ({ database } = requireRuntimeAdministrator(Astro.locals.session, {
    hideExistence: true,
  }));
} catch {
  return hiddenManagementPage();
}
applyResponsePolicy(Astro.response.headers, "manage");
const publishing = createPublishingServer(database);
const initialJobs = publishing
  .listRecentJobs(50)
  .map((job) => publishing.serializeJobStatus(job)) as readonly TaskView[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>后台任务 · Mirawind</title>
  </head>
  <body class="m-0 bg-stone-100 font-sans text-stone-800">
    <ManageShell currentSection="tasks">
      <TaskMonitor client:load initialJobs={initialJobs} />
    </ManageShell>
  </body>
</html>
