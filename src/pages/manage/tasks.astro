---
import { TaskMonitor, type TaskView } from "@/components/import/TaskMonitor";
import { JobRepository } from "@/db/repositories/jobs";
import {
  hiddenManagementPage,
  redirectToAdministratorLogin,
} from "@/http/authorization/manage-page";
import { requireRuntimeAdministrator } from "@/http/authorization/runtime-admin";
import { applyResponsePolicy } from "@/http/cache/policies";
import { serializeJobStatus } from "@/services/job-status";

export const prerender = false;

// Astro's frontmatter checker does not count return expressions as symbol reads.
void hiddenManagementPage;
void redirectToAdministratorLogin;

if (!Astro.locals.session) {
  return redirectToAdministratorLogin(Astro.url.pathname);
}

let database;
try {
  ({ database } = requireRuntimeAdministrator(Astro.locals.session, {
    hideExistence: true,
  }));
} catch {
  return hiddenManagementPage();
}
applyResponsePolicy(Astro.response.headers, "manage");
const initialJobs = new JobRepository(database)
  .listRecent(50)
  .map((job) => serializeJobStatus(job)) as readonly TaskView[];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>后台任务 · Mirawind</title>
  </head>
  <body>
    <main>
      <nav aria-label="管理导航"><a href="/manage">返回导入</a></nav>
      <TaskMonitor client:load initialJobs={initialJobs} />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    color: #25211b;
    background: #f4efe6;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  main {
    width: min(72rem, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }
  nav {
    margin-bottom: 2rem;
  }
  :global(.task-monitor > header),
  :global(.task-heading),
  :global(.task-actions) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  :global(.task-list) {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  :global(.task-card) {
    padding: 1.25rem;
    border: 1px solid #d7ccbd;
    border-radius: 1rem;
    background: #fffdf8;
  }
  :global(.task-heading code) {
    display: block;
    margin-top: 0.4rem;
    color: #6f665a;
  }
  :global(.task-heading span) {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #e4ede6;
  }
  :global(.task-facts),
  :global(.task-progress) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  :global(dt) {
    color: #6f665a;
    font-size: 0.85rem;
  }
  :global(dd) {
    margin: 0.2rem 0 0;
  }
  :global(.task-error) {
    color: #9b3228;
  }
  :global(button) {
    min-height: 2.5rem;
    padding: 0.55rem 0.8rem;
    border: 0;
    border-radius: 0.6rem;
    color: white;
    background: #2f5b49;
    font: inherit;
    cursor: pointer;
  }
  :global(button:disabled) {
    cursor: wait;
    opacity: 0.6;
  }
</style>
