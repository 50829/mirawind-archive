---
import { ImportUploader } from "@/web/components/import/ImportUploader";
import {
  hiddenManagementPage,
  redirectToAdministratorLogin,
} from "@/http/authorization/manage-page";
import { requireRuntimeAdministrator } from "@/http/authorization/runtime-admin";
import { applyResponsePolicy } from "@/http/cache/policies";
import "@/styles/global.css";

export const prerender = false;

// Astro's frontmatter checker does not count return expressions as symbol reads.
void hiddenManagementPage;
void redirectToAdministratorLogin;

if (!Astro.locals.session) {
  return redirectToAdministratorLogin(Astro.url.pathname);
}
try {
  requireRuntimeAdministrator(Astro.locals.session, { hideExistence: true });
} catch {
  return hiddenManagementPage();
}
applyResponsePolicy(Astro.response.headers, "manage");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>导入书籍 · Mirawind</title>
  </head>
  <body class="m-0 bg-stone-100 font-sans text-stone-800">
    <main class="mx-auto w-[min(66rem,calc(100vw-2rem))] py-16">
      <ImportUploader client:load />
      <p class="mt-6 text-sm text-stone-600">
        <a
          class="font-medium text-emerald-800 hover:text-emerald-900"
          href="/manage/tasks">后台任务</a
        >
        ·
        <a
          class="font-medium text-emerald-800 hover:text-emerald-900"
          href="/manage/security">Passkey 安全设置</a
        >
      </p>
    </main>
  </body>
</html>
