---
import { createPublishingDraftServer } from "@/composition/server/publishing-drafts";
import { publishingReaderRendererAssets } from "@/modules/publishing/application/publishing-api";
import { PublishingWorkbench } from "@/web/components/manage/PublishingWorkbench";
import ManageShell from "@/web/components/manage/ManageShell.astro";
import { hiddenManagementPage } from "@/http/authorization/manage-page";
import { requireRuntimeAdministrator } from "@/http/authorization/runtime-admin";
import { applyResponsePolicy } from "@/http/cache/policies";
import "@/styles/global.css";

export const prerender = false;

// Astro's frontmatter checker does not count return expressions as symbol reads.
void hiddenManagementPage;

const administrator = (() => {
  try {
    return requireRuntimeAdministrator(Astro.locals.session, {
      hideExistence: true,
    });
  } catch {
    return null;
  }
})();
if (!administrator) {
  return hiddenManagementPage();
}
const { database } = administrator;
const bookId = Number(Astro.params.bookId);
const book = Number.isSafeInteger(bookId)
  ? createPublishingDraftServer(database).findBook(bookId)
  : null;
if (!book?.draftImportId) {
  return hiddenManagementPage();
}
applyResponsePolicy(Astro.response.headers, "manage");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>出版工作台 · Mirawind</title>
    <link
      rel="stylesheet"
      href={publishingReaderRendererAssets.stylesheetUrl}
    />
  </head>
  <body class="m-0 bg-stone-100 font-sans text-stone-800">
    <ManageShell currentSection="library" wide>
      <PublishingWorkbench bookId={bookId} client:load />
    </ManageShell>
  </body>
</html>
