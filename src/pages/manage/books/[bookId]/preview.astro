---
import { StructurePreview } from "@/components/preview/StructurePreview";
import { hiddenManagementPage } from "@/http/authorization/manage-page";
import { requireRuntimeAdministrator } from "@/http/authorization/runtime-admin";
import { applyResponsePolicy } from "@/http/cache/policies";
import "@/styles/global.css";

export const prerender = false;

// Astro's frontmatter checker does not count return expressions as symbol reads.
void hiddenManagementPage;

try {
  requireRuntimeAdministrator(Astro.locals.session, { hideExistence: true });
} catch {
  return hiddenManagementPage();
}
const bookId = Number(Astro.params.bookId);
if (!Number.isSafeInteger(bookId) || bookId < 1) {
  return hiddenManagementPage();
}
applyResponsePolicy(Astro.response.headers, "manage");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>结构预览 · Mirawind</title>
  </head>
  <body>
    <main>
      <nav><a href="/manage">← 返回导入</a></nav>
      <StructurePreview bookId={bookId} client:load />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
    color: var(--color-stone-800);
    background: var(--color-stone-100);
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }
  main {
    width: min(90rem, calc(100vw - 2rem));
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }
  nav {
    margin-bottom: 2rem;
  }
  :global(.preview-header),
  :global(.structure-panel),
  :global(.document-panel) {
    padding: 1.5rem;
    border: 1px solid var(--color-stone-300);
    border-radius: 1rem;
    background: var(--color-white);
  }
  :global(.preview-header) {
    margin-bottom: 1rem;
  }
  :global(.preview-grid) {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(18rem, 26rem) minmax(0, 1fr);
  }
  :global(.heading-list) {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  :global(.heading-list li),
  :global(.heading-list span) {
    display: block;
  }
  :global(.heading-list span),
  :global(.quiet) {
    color: var(--color-stone-600);
    font-size: 0.875rem;
  }
  :global(.stale),
  :global(.diagnostics-panel li) {
    color: var(--color-amber-800);
  }
  :global(label) {
    display: grid;
    gap: 0.4rem;
    margin: 1rem 0;
  }
  :global(select) {
    min-height: 2.75rem;
    padding: 0.5rem;
    font: inherit;
  }
  :global(input) {
    min-height: 2.75rem;
    padding: 0.5rem;
    border: 1px solid var(--color-stone-400);
    border-radius: 0.4rem;
    font: inherit;
  }
  :global(input[type="checkbox"]) {
    min-height: auto;
  }
  :global(button) {
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    border: 0;
    border-radius: 0.5rem;
    color: var(--color-white);
    background: var(--color-stone-700);
    font: inherit;
    cursor: pointer;
  }
  :global(button:disabled) {
    cursor: wait;
    opacity: 0.6;
  }
  :global(.structure-editor) {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-stone-200);
  }
  :global(.publish-panel) {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-stone-200);
  }
  :global(.publish-outcome) {
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid var(--color-emerald-200);
    border-radius: 0.65rem;
    background: var(--color-emerald-50);
  }
  :global(.publish-outcome[data-state="failed"]),
  :global(.publish-outcome[data-state="interrupted"]),
  :global(.publish-outcome[data-state="canceled"]) {
    border-color: var(--color-amber-200);
    background: var(--color-amber-50);
  }
  :global(.publish-outcome nav) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  :global(.structure-edit-list) {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }
  :global(.structure-edit-list > li) {
    padding: 0.75rem;
    border: 1px solid var(--color-stone-200);
    border-radius: 0.5rem;
  }
  :global(.source-heading) {
    margin: 0;
    font-weight: 600;
  }
  :global(.structure-fields),
  :global(.structure-checks) {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  :global(.structure-checks label) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  :global(iframe) {
    width: 100%;
    min-height: 70vh;
    border: 1px solid var(--color-stone-200);
    border-radius: 0.5rem;
    background: var(--color-white);
  }
  @media (max-width: 850px) {
    :global(.preview-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
