---
import type { Passkey } from "@better-auth/passkey";

import { getRuntimeAuth, getRuntimeDatabase } from "@/composition/auth";
import { createIdentityServer } from "@/composition/server/identity";
import { localDevelopmentSessionId } from "@/modules/identity/application/identity-api";
import {
  PasskeyManager,
  type ManagedPasskey,
} from "@/web/components/auth/PasskeyManager";
import ManageShell from "@/web/components/manage/ManageShell.astro";
import {
  hiddenManagementPage,
  redirectToAdministratorLogin,
} from "@/http/authorization/manage-page";
import { applyResponsePolicy } from "@/http/response-policy";
import "@/styles/global.css";

export const prerender = false;

// Astro's frontmatter checker does not count return expressions as symbol reads.
void hiddenManagementPage;
void redirectToAdministratorLogin;

applyResponsePolicy(Astro.response.headers, "manage");

const session = Astro.locals.session;
if (!session) {
  return redirectToAdministratorLogin(Astro.url.pathname);
}

const adminUserId = createIdentityServer(getRuntimeDatabase()).adminUserId();
if (!adminUserId || session.user.id !== adminUserId) {
  return hiddenManagementPage();
}

const localDevelopment = session.sessionId === localDevelopmentSessionId;
const passkeys = localDevelopment
  ? []
  : await getRuntimeAuth().api.listPasskeys({
      headers: Astro.request.headers,
    });
const lastUsedByPasskey = new Map(
  (
    getRuntimeDatabase()
      .prepare("SELECT passkey_id, last_used_at FROM passkey_usage")
      .all() as { passkey_id: string; last_used_at: number }[]
  ).map((row) => [row.passkey_id, row.last_used_at]),
);
function lastUsedIso(passkeyId: string): string | null {
  const value = lastUsedByPasskey.get(passkeyId);
  return value === undefined ? null : new Date(value).toISOString();
}
const initialPasskeys: ManagedPasskey[] = (passkeys as Passkey[]).map(
  (passkey) => ({
    backedUp: passkey.backedUp,
    createdAt: passkey.createdAt
      ? new Date(passkey.createdAt).toISOString()
      : null,
    deviceType: passkey.deviceType,
    id: passkey.id,
    lastUsedAt: lastUsedIso(passkey.id),
    name: passkey.name ?? null,
  }),
);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>安全设置 · Mirawind</title>
  </head>
  <body class="m-0 bg-stone-100 font-sans text-stone-800">
    <ManageShell currentSection="security">
      {
        localDevelopment ? (
          <section aria-labelledby="local-security-title" class="max-w-2xl">
            <h1
              id="local-security-title"
              class="text-2xl font-bold text-stone-900"
            >
              安全设置
            </h1>
            <dl class="mt-6 grid gap-4 text-stone-700">
              <div>
                <dt class="text-sm text-stone-500">当前环境</dt>
                <dd class="m-0 mt-1 font-medium">本地开发</dd>
              </div>
              <div>
                <dt class="text-sm text-stone-500">登录状态</dt>
                <dd class="m-0 mt-1 font-medium">本地管理员免登录</dd>
              </div>
            </dl>
          </section>
        ) : (
          <PasskeyManager client:load initialPasskeys={initialPasskeys} />
        )
      }
    </ManageShell>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(.heading-row) {
    display: flex;
    align-items: end;
    justify-content: space-between;
  }

  :global(.eyebrow) {
    margin: 0;
    color: var(--color-amber-800);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  :global(#passkey-heading) {
    margin: 0.2rem 0;
    font-family: Georgia, serif;
    font-size: 3rem;
  }

  :global(.count) {
    padding: 0.4rem 0.65rem;
    border-radius: 99rem;
    color: var(--color-white);
    background: var(--color-stone-700);
  }

  :global(.add-form),
  :global(.passkey-list li) {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--color-stone-300);
    border-radius: 0.75rem;
    background: var(--color-stone-50);
  }

  :global(.passkey-list) {
    padding: 0;
    list-style: none;
  }

  :global(.passkey-list li) {
    display: grid;
    gap: 1rem;
  }

  :global(form) {
    display: flex;
    gap: 0.75rem;
    align-items: end;
  }

  :global(label) {
    display: grid;
    flex: 1;
    gap: 0.35rem;
  }

  :global(input),
  :global(button) {
    min-height: 2.6rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-stone-500);
    border-radius: 0.4rem;
    font: inherit;
  }

  :global(button) {
    color: var(--color-white);
    background: var(--color-stone-700);
    cursor: pointer;
  }

  :global(button:disabled) {
    cursor: wait;
    opacity: 0.55;
  }

  :global(.danger) {
    padding-top: 1rem;
    border-top: 1px solid var(--color-red-200);
  }

  :global(.danger button),
  :global(.danger-button) {
    background: var(--color-red-800);
  }

  :global(.message),
  :global(.empty) {
    padding: 0.8rem 1rem;
    border-radius: 0.4rem;
    background: var(--color-stone-200);
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 40rem) {
    :global(form) {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
