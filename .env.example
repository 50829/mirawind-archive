# Public, non-secret configuration
MIRAWIND_DATA_DIR=/srv/mirawind/data
MIRAWIND_PUBLIC_ORIGIN=https://library.example.test
MIRAWIND_PASSKEY_RP_ID=library.example.test
MIRAWIND_ALLOWED_HOSTS=library.example.test

# Generate at least 32 random bytes and inject it through the deployment secret store.
# Never commit a real value.
MIRAWIND_AUTH_SECRET=replace-with-at-least-32-random-bytes
