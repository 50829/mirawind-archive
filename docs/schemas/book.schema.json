{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirawind.local/schemas/book.schema.json",
  "title": "Mirawind book.yaml schema v2",
  "description": "Portable publishing configuration. It must not contain body text or private reading data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "book_id",
    "title",
    "source",
    "publishing",
    "source_regions",
    "structure"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "book_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "alias": {
      "$ref": "book.v1.schema.json#/$defs/structureNode/properties/alias"
    },
    "metadata": {
      "$ref": "book.v1.schema.json#/$defs/metadata"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "publishing": {
      "$ref": "book.v1.schema.json#/$defs/publishing"
    },
    "source_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRegion"
      },
      "maxItems": 32
    },
    "structure": {
      "type": "array",
      "description": "Heading overrides in Markdown source order, including reference-only regions.",
      "items": {
        "$ref": "book.v1.schema.json#/$defs/structureNode"
      },
      "maxItems": 20000
    }
  },
  "$defs": {
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_markdown",
        "main_markdown_sha256",
        "original_files",
        "preprocessing"
      ],
      "properties": {
        "main_markdown": {
          "$ref": "book.v1.schema.json#/$defs/relativePath"
        },
        "main_markdown_sha256": {
          "$ref": "book.v1.schema.json#/$defs/sha256"
        },
        "original_files": {
          "type": "array",
          "items": {
            "$ref": "book.v1.schema.json#/$defs/originalFile"
          },
          "maxItems": 100
        },
        "preprocessing": {
          "$ref": "#/$defs/preprocessing"
        }
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typography"
      ],
      "properties": {
        "typography": {
          "$ref": "#/$defs/typographyProvenance"
        }
      }
    },
    "typographyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "input_sha256",
        "output_sha256",
        "spaces_normalized",
        "punctuation_converted",
        "protected_nodes"
      ],
      "properties": {
        "profile": {
          "enum": [
            "preserve-v1",
            "zh-smart-v1"
          ]
        },
        "input_sha256": {
          "$ref": "book.v1.schema.json#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "book.v1.schema.json#/$defs/sha256"
        },
        "spaces_normalized": {
          "$ref": "#/$defs/counter"
        },
        "punctuation_converted": {
          "$ref": "#/$defs/counter"
        },
        "protected_nodes": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "byteRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_byte",
        "end_byte",
        "sha256"
      ],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "$ref": "book.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "sourceRegionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "reference_level"
      ],
      "properties": {
        "range": {
          "$ref": "#/$defs/byteRange"
        },
        "reference_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "body_heading_block_id": {
          "$ref": "book.v1.schema.json#/$defs/blockId"
        }
      }
    },
    "sourceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "kind",
        "disposition",
        "source_path",
        "source_sha256",
        "range",
        "entries"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "pattern": "^region_[A-Za-z0-9_-]{16,80}$"
        },
        "kind": {
          "const": "printed_toc"
        },
        "disposition": {
          "const": "reference_only"
        },
        "source_path": {
          "$ref": "book.v1.schema.json#/$defs/relativePath"
        },
        "source_sha256": {
          "$ref": "book.v1.schema.json#/$defs/sha256"
        },
        "range": {
          "$ref": "#/$defs/byteRange"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRegionEntry"
          },
          "maxItems": 20000
        }
      }
    }
  },
  "x-semantic-validations": [
    "book_id must match the owning book",
    "revision must increase on every accepted configuration change",
    "preprocessing output_sha256 must equal main_markdown_sha256",
    "source regions and entries must be ordered, non-overlapping and within the normalized source",
    "source region and entry hashes must match exact UTF-8 byte ranges",
    "source region boundaries must align to complete document-root blocks",
    "body heading mappings must target unique later headings in monotonic order",
    "all source-region entries across the book must not exceed 20000",
    "structure entries must reference all source heading blocks in source order",
    "active display levels must form a continuous valid hierarchy",
    "reference-only regions cannot remove an actively referenced definition or footnote",
    "unknown properties are rejected for schema_version 2",
    "body text and private notes, annotations, bookmarks, or progress are forbidden"
  ]
}
