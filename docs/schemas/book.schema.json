{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirawind.local/schemas/book.schema.json",
  "title": "Mirawind book.yaml schema",
  "description": "Portable publishing configuration. It must not contain body text or private reading data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "book_id",
    "title",
    "source",
    "publishing",
    "structure"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "book_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "alias": {
      "type": "string",
      "pattern": "^(?![0-9]+$)[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "publishing": {
      "$ref": "#/$defs/publishing"
    },
    "structure": {
      "type": "array",
      "description": "Heading overrides in Markdown source order.",
      "items": {
        "$ref": "#/$defs/structureNode"
      },
      "maxItems": 20000
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blockId": {
      "type": "string",
      "pattern": "^blk_[A-Za-z0-9_-]{16,80}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtitle": {
          "type": "string",
          "maxLength": 500
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "publisher": {
          "type": "string",
          "maxLength": 300
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "edition": {
          "type": "string",
          "maxLength": 100
        },
        "isbn_10": {
          "type": "string",
          "pattern": "^[0-9]{9}[0-9X]$"
        },
        "isbn_13": {
          "type": "string",
          "pattern": "^[0-9]{13}$"
        },
        "cover_resource_id": {
          "type": "string",
          "pattern": "^res_[A-Za-z0-9_-]{16,80}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_markdown",
        "main_markdown_sha256",
        "original_files"
      ],
      "properties": {
        "main_markdown": {
          "$ref": "#/$defs/relativePath"
        },
        "main_markdown_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalFile"
          },
          "maxItems": 100
        }
      }
    },
    "originalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "path",
        "filename",
        "media_type",
        "size",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^file_[A-Za-z0-9_-]{16,80}$"
        },
        "role": {
          "enum": [
            "mineru_zip",
            "pdf",
            "epub",
            "image_archive",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numbering",
        "code"
      ],
      "properties": {
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "normalized",
                "preserve"
              ]
            }
          }
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line_numbers"
          ],
          "properties": {
            "line_numbers": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "include_in_toc",
        "display_level",
        "starts_page"
      ],
      "properties": {
        "block_id": {
          "$ref": "#/$defs/blockId"
        },
        "include_in_toc": {
          "type": "boolean"
        },
        "display_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "display_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "starts_page": {
          "type": "boolean"
        },
        "role": {
          "enum": [
            "frontmatter",
            "body",
            "appendix",
            "backmatter"
          ]
        },
        "alias": {
          "type": "string",
          "pattern": "^(?![0-9]+$)[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        }
      }
    }
  },
  "x-semantic-validations": [
    "book_id must match the owning book",
    "revision must increase on every accepted configuration change",
    "main_markdown and original file paths must resolve inside the version root",
    "original file ids and structure block ids must be unique",
    "structure entries must reference heading blocks and remain in Markdown source order",
    "display levels must form a continuous valid hierarchy without skipped levels",
    "role is only set on top-level content and descendants inherit it",
    "starts_page may only be true for heading blocks",
    "aliases must be unique in their applicable scope",
    "unknown properties are rejected for schema_version 1",
    "body text and private notes, annotations, bookmarks, or progress are forbidden"
  ]
}
