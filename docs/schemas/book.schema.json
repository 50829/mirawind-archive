{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirawind.local/schemas/book.schema.json",
  "title": "Mirawind book.yaml schema v3",
  "description": "Portable publishing configuration. It must not contain body text or private reading data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "book_id",
    "title",
    "source",
    "publishing",
    "source_regions",
    "structure"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "book_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "alias": {
      "$ref": "#/$defs/structureNode/properties/alias"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "publishing": {
      "$ref": "#/$defs/publishing"
    },
    "source_regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRegion"
      },
      "maxItems": 32
    },
    "structure": {
      "type": "array",
      "description": "Heading overrides in Markdown source order, including reference-only regions.",
      "items": {
        "$ref": "#/$defs/structureNode"
      },
      "maxItems": 20000
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blockId": {
      "type": "string",
      "pattern": "^blk_[A-Za-z0-9_-]{16,80}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtitle": {
          "type": "string",
          "maxLength": 500
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "publisher": {
          "type": "string",
          "maxLength": 300
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "edition": {
          "type": "string",
          "maxLength": 100
        },
        "isbn_10": {
          "type": "string",
          "pattern": "^[0-9]{9}[0-9X]$"
        },
        "isbn_13": {
          "type": "string",
          "pattern": "^[0-9]{13}$"
        },
        "cover_resource_id": {
          "type": "string",
          "pattern": "^res_[A-Za-z0-9_-]{16,80}$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_markdown",
        "main_markdown_sha256",
        "original_files",
        "preprocessing"
      ],
      "properties": {
        "main_markdown": {
          "$ref": "#/$defs/relativePath"
        },
        "main_markdown_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/originalFile"
          },
          "maxItems": 100
        },
        "preprocessing": {
          "$ref": "#/$defs/preprocessing"
        }
      }
    },
    "originalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "path",
        "filename",
        "media_type",
        "size",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^file_[A-Za-z0-9_-]{16,80}$"
        },
        "role": {
          "enum": ["mineru_zip", "pdf", "epub", "image_archive", "other"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483648
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numbering", "code"],
      "properties": {
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "enum": ["normalized", "preserve"]
            }
          }
        },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line_numbers"],
          "properties": {
            "line_numbers": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "structureNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "include_in_toc",
        "display_level",
        "starts_page"
      ],
      "properties": {
        "block_id": {
          "$ref": "#/$defs/blockId"
        },
        "include_in_toc": {
          "type": "boolean"
        },
        "display_title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "display_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "starts_page": {
          "type": "boolean"
        },
        "role": {
          "enum": ["frontmatter", "body", "appendix", "backmatter"]
        },
        "alias": {
          "type": "string",
          "pattern": "^(?![0-9]+$)[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        }
      }
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typography"],
      "properties": {
        "typography": {
          "$ref": "#/$defs/typographyProvenance"
        }
      }
    },
    "typographyProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "input_sha256",
        "output_sha256",
        "spaces_normalized",
        "punctuation_converted",
        "protected_nodes"
      ],
      "properties": {
        "profile": {
          "enum": ["verbatim-v1", "zh-smart-v1"]
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spaces_normalized": {
          "$ref": "#/$defs/counter"
        },
        "punctuation_converted": {
          "$ref": "#/$defs/counter"
        },
        "protected_nodes": {
          "$ref": "#/$defs/counter"
        }
      }
    },
    "byteRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_byte", "end_byte", "sha256"],
      "properties": {
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceRegionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range", "reference_level"],
      "properties": {
        "range": {
          "$ref": "#/$defs/byteRange"
        },
        "reference_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "body_heading_block_id": {
          "$ref": "#/$defs/blockId"
        }
      }
    },
    "sourceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "applied",
        "kind",
        "disposition",
        "source_path",
        "source_sha256",
        "range",
        "entries"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "region_id": {
          "type": "string",
          "pattern": "^region_[A-Za-z0-9_-]{16,80}$"
        },
        "kind": {
          "const": "printed_toc"
        },
        "disposition": {
          "const": "reference_only"
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "range": {
          "$ref": "#/$defs/byteRange"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRegionEntry"
          },
          "maxItems": 20000
        }
      }
    }
  },
  "x-semantic-validations": [
    "book_id must match the owning book",
    "revision must increase on every accepted configuration change",
    "preprocessing output_sha256 must equal main_markdown_sha256",
    "source regions and entries must be ordered, non-overlapping and within the normalized source",
    "source region and entry hashes must match exact UTF-8 byte ranges",
    "source region boundaries must align to complete document-root blocks",
    "body heading mappings must target unique later headings in monotonic order",
    "all source-region entries across the book must not exceed 20000",
    "structure entries must reference all source heading blocks in source order",
    "active display levels must form a continuous valid hierarchy",
    "reference-only regions cannot remove an actively referenced definition or footnote",
    "unknown properties are rejected for schema_version 3",
    "body text and private notes, annotations, bookmarks, or progress are forbidden"
  ]
}
